{
  "expo": {
    "name": "Imedica",
    "slug": "imedica",
    "scheme": "imedica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ca.imedica.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ca.imedica.app",
      "adaptiveIcon": {
        "backgroundColor": "#06110E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06110E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Imedica uses your photos so you can choose a profile picture.",
          "cameraPermission": "Imedica uses the camera so you can take a profile picture."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#123D31"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Imedica uses Face ID to unlock the app, if you turn the lock on."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ebceb9f-1510-4c56-9f98-f9473992cdc6"
      }
    },
    "owner": "ashavid"
  }
}
