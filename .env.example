# ─── Database ────────────────────────────────────────────────────────────────
# Local: `docker compose up -d` starts Postgres on 54329.
# Production: a managed Postgres in a Canadian region (e.g. Toronto / Montréal).
DATABASE_URL="postgresql://imedica:imedica_dev@localhost:54329/imedica"

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# Keys the one-way hash that links an identity to its de-identified analytics.
# Rotating it severs every existing link — treat it like a database encryption key.
DEIDENTIFICATION_SECRET=""

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ─── AI feedback (optional) ──────────────────────────────────────────────────
# Without a key, sessions still score and show physician-written feedback;
# only the AI explanation layer is skipped.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# ─── Email (optional) ────────────────────────────────────────────────────────
# Without a key, invite and reset links are written to the server log instead.
RESEND_API_KEY=""
EMAIL_FROM="Imedica <no-reply@imedica.ca>"
